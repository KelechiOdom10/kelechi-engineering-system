{
  "description": "Personal Humaans repository guardrails and post-edit checks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/hooks/block-npm-in-repo.sh\"",
            "timeout": 15,
            "statusMessage": "Checking Humaans package-manager usage"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/hooks/check-pr-title.sh\"",
            "timeout": 15,
            "statusMessage": "Checking Humaans PR title"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/hooks/check-comments.sh\"",
            "timeout": 15,
            "statusMessage": "Checking added source comments"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/hooks/format-edited-files.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting edited Humaans files"
          }
        ]
      }
    ]
  }
}
